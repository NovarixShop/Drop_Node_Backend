# Copy to .env.local (used by docker-compose.yml via env_file) and fill in real values.
# NEVER commit the real file. Generate secrets with:  openssl rand -hex 48

NODE_ENV=production

# --- Databases ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/ecommerce
REDIS_URL=redis://:PASSWORD@redis.example.com:6379

# --- Secrets (required in production; services refuse to start without them) ---
# Each must be at least 32 characters, and the two JWT secrets must differ.
JWT_SECRET=
JWT_REFRESH_SECRET=
# Shared by all services for /api/internal/* calls (stock reservation, cart reads, counts).
INTERNAL_API_KEY=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Public URLs ---
# Origins allowed to call the API from a browser (storefront + CMS), comma-separated, no trailing slash.
# The gateway refuses to start in production without it.
CORS_ORIGINS=https://shop.example.com,https://admin.example.com
# Public URL of the API (gateway) including /api. Used to build uploaded image URLs.
PUBLIC_API_URL=https://api.example.com/api
# Storefront URL used in verification / password-reset emails.
FRONTEND_URL=https://shop.example.com
# Set to 1 when the gateway sits behind one reverse proxy (nginx, a load balancer, Cloudflare...).
TRUST_PROXY=1

# --- Payments (Razorpay, handled by order-service) ---
# From the Razorpay dashboard: Settings -> API Keys. Use rzp_test_* keys until you go live.
# The key id is sent to the browser (it has to be); the secret and webhook secret are
# server-only. Card checkout returns 503 until both of the first two are set; COD keeps working.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings -> Webhooks: create a webhook pointing at  <PUBLIC_API_URL>/payments/webhook
# subscribed to `payment.captured` and `payment.failed`, and paste its secret here.
# Without it, a shopper who closes the tab right after paying is never reconciled.
RAZORPAY_WEBHOOK_SECRET=
# Only if your Razorpay account settles in something other than INR.
# RAZORPAY_CURRENCY=INR

# --- Email (SMTP) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Drop Store <no-reply@example.com>"

# --- Google sign-in ---
GOOGLE_CLIENT_ID=

# --- Uploaded image clean-up (catalog-service) ---
# How often unused uploaded images are deleted (hours; 0 disables) and how old they must be first.
UPLOAD_CLEANUP_INTERVAL_HOURS=24
UPLOAD_CLEANUP_GRACE_HOURS=24
